<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No broad storage permissions requested. Footage is imported through
        the system document picker (Storage Access Framework), so we take a
        persistable URI permission per file instead of asking for
        READ_EXTERNAL_STORAGE / MANAGE_EXTERNAL_STORAGE. Cheaper for the user
        to grant, and it survives Android's scoped-storage rules on every
        API level we support (24+) without extra code paths.
    -->

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.TrackStudio"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.TrackStudio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
